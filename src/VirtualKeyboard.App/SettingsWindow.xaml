<Window x:Class="VirtualKeyboard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard settings"
        Width="490"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Icon="Assets/VirtualKeyboard.ico"
        FontFamily="Segoe UI, Arial">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Grid Margin="8,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter />
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource SubtleTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,5,28,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <Border Background="{DynamicResource ControlBackgroundBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,2,0,0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource KeyHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="17"
                                    Height="17"
                                    Margin="0,0,9,0"
                                    CornerRadius="4"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1.2">
                                <Path x:Name="CheckMark"
                                      Data="M 3,8.5 L 6.5,12 L 13,4.5"
                                      Stroke="{DynamicResource AccentTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{DynamicResource ControlBorderBrush}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         Stroke="{DynamicResource ControlBackgroundBrush}"
                                                         StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource KeyHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource KeyDeckBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Keyboard settings"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14" />

        <!-- Appearance -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8" />

                <TextBlock Text="Theme" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemeCombo" Margin="0,0,0,10" SelectionChanged="ThemeCombo_SelectionChanged" />

                <TextBlock Text="Layout" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="LayoutCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="English (QWERTY)" Tag="en" />
                    <ComboBoxItem Content="العربية (Arabic, RTL)" Tag="ar" />
                </ComboBox>

                <TextBlock Text="Key height" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="KeyHeightSlider"
                            Minimum="34"
                            Maximum="96"
                            TickFrequency="2"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="KeyHeightSlider_ValueChanged" />
                    <TextBlock x:Name="KeyHeightValue"
                               Grid.Column="1"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Typing & Suggestions -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="TYPING &amp; SUGGESTIONS" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8" />

                <CheckBox x:Name="SuggestionsCheck"
                          Content="Show word suggestions"
                          Margin="0,0,0,10" />

                <TextBlock Text="Suggestions shown" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="SuggestionCountCombo" Margin="0,0,0,10">
                    <ComboBoxItem Content="3" Tag="3" />
                    <ComboBoxItem Content="5" Tag="5" />
                    <ComboBoxItem Content="7" Tag="7" />
                    <ComboBoxItem Content="9" Tag="9" />
                </ComboBox>

                <CheckBox x:Name="AddSpaceCheck"
                          Content="Add a space after tapping a suggestion" />
            </StackPanel>
        </Border>

        <!-- Behavior -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <TextBlock Text="BEHAVIOR" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,8" />

                <CheckBox x:Name="SoundCheck"
                          Content="Click sound"
                          Margin="0,0,0,10" />

                <CheckBox x:Name="AutoShowCheck"
                          Content="Show automatically when a text field is focused"
                          Margin="0,0,0,10" />

                <CheckBox x:Name="AutostartCheck"
                          Content="Start with Windows"
                          Margin="0,0,0,10" />

                <TextBlock x:Name="HotkeyText"
                           Text="Global hotkey: Ctrl + Alt + K"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           FontSize="11.5" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel"
                    MinWidth="88"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="88"
                    Padding="10,6"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
