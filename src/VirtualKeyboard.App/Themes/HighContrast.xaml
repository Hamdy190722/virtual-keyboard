<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Strict WCAG AAA contrast with 2px borders and unmistakable Armed vs Locked states -->
    <SolidColorBrush x:Key="WindowBrush" Color="#000000" />
    <SolidColorBrush x:Key="HeaderAccentBrush" Color="#FFD400" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KeyDeckBrush" Color="#000000" />
    <SolidColorBrush x:Key="KeyBorderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KeyBrush" Color="#000000" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#262626" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#4D4D4D" />
    <SolidColorBrush x:Key="KeyBevelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KeyTopHighlightBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ModifierBrush" Color="#141414" />
    <SolidColorBrush x:Key="EnterKeyBrush" Color="#FFD400" />
    <SolidColorBrush x:Key="EnterKeyHoverBrush" Color="#FFE44D" />
    <SolidColorBrush x:Key="EnterKeyTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD400" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="ArmedBackgroundBrush" Color="#002B36" />
    <SolidColorBrush x:Key="ArmedBorderBrush" Color="#00E5FF" />
    <SolidColorBrush x:Key="SuggestionBrush" Color="#0D0D0D" />
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SpaceBarAccentBrush" Color="#FFD400" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFFFFF" />

    <Color x:Key="KeyGlowColor">#00000000</Color>
    <sys:Double x:Key="KeyGlowOpacity">0.0</sys:Double>
    <sys:Double x:Key="KeyGlowBlur">0</sys:Double>
    <Thickness x:Key="KeyBorderThickness">2</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">4</CornerRadius>
</ResourceDictionary>
