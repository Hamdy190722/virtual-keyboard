<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Sakura Blossom: Soft blush-cream chassis, rose-tinted deck, petal-white keycaps -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FEF2F6" Offset="0" />
        <GradientStop Color="#F9E4EC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderAccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F472B6" Offset="0" />
        <GradientStop Color="#DB2777" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BorderBrush" Color="#EBB9CC" />
    <SolidColorBrush x:Key="KeyDeckBrush" Color="#F2D5E0" />
    <SolidColorBrush x:Key="KeyBorderBrush" Color="#F0C2D3" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFF7FA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#FFE4EE" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#FBCFE0" />
    <SolidColorBrush x:Key="KeyBevelBrush" Color="#E2AFC2" />
    <SolidColorBrush x:Key="KeyTopHighlightBrush" Color="#CCFFFFFF" />
    <LinearGradientBrush x:Key="ModifierBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FCE1EB" Offset="0" />
        <GradientStop Color="#F7CFE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EnterKeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EC4899" Offset="0" />
        <GradientStop Color="#DB2777" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EnterKeyHoverBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="EnterKeyTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#3A1E2B" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#8C586E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#DB2777" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ArmedBackgroundBrush" Color="#FCE7F3" />
    <SolidColorBrush x:Key="ArmedBorderBrush" Color="#DB2777" />
    <SolidColorBrush x:Key="SuggestionBrush" Color="#FFF9FB" />
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#E8AFC4" />
    <SolidColorBrush x:Key="SpaceBarAccentBrush" Color="#DB2777" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#E6B2C6" />

    <Color x:Key="KeyGlowColor">#F472B6</Color>
    <sys:Double x:Key="KeyGlowOpacity">0.20</sys:Double>
    <sys:Double x:Key="KeyGlowBlur">8</sys:Double>
    <Thickness x:Key="KeyBorderThickness">1</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">9</CornerRadius>
    <sys:String x:Key="ThemeBadgeText">SAKURA</sys:String>
</ResourceDictionary>
