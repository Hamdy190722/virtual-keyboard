<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Windows 11 Graphite Dark: layered anodized chassis, recessed keybed, cobalt accents -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171A23" Offset="0" />
        <GradientStop Color="#11141C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderAccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E3546" />
    <SolidColorBrush x:Key="KeyDeckBrush" Color="#0D1017" />
    <SolidColorBrush x:Key="KeyBorderBrush" Color="#394156" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A3040" Offset="0" />
        <GradientStop Color="#222735" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#353D52" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#1C212E" />
    <SolidColorBrush x:Key="KeyBevelBrush" Color="#10131C" />
    <SolidColorBrush x:Key="KeyTopHighlightBrush" Color="#26FFFFFF" />
    <LinearGradientBrush x:Key="ModifierBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#212634" Offset="0" />
        <GradientStop Color="#1A1E2A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EnterKeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EnterKeyHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="EnterKeyTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6FC" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9BA6BC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ArmedBackgroundBrush" Color="#1A2C4A" />
    <SolidColorBrush x:Key="ArmedBorderBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="SuggestionBrush" Color="#131722" />
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#2C3344" />
    <SolidColorBrush x:Key="SpaceBarAccentBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E2330" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#364056" />

    <Color x:Key="KeyGlowColor">#3B82F6</Color>
    <sys:Double x:Key="KeyGlowOpacity">0.18</sys:Double>
    <sys:Double x:Key="KeyGlowBlur">8</sys:Double>
    <Thickness x:Key="KeyBorderThickness">1</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">7</CornerRadius>
</ResourceDictionary>
