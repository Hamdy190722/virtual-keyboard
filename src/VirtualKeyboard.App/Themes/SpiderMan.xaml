<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Spider-Man (Marvel): Midnight spider-navy chassis, deep web deck, crimson suit modifiers -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0D162B" Offset="0" />
        <GradientStop Color="#080F1F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderAccentBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#EF233C" Offset="0" />
        <GradientStop Color="#3B82F6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BorderBrush" Color="#283E66" />
    <SolidColorBrush x:Key="KeyDeckBrush" Color="#070C18" />
    <SolidColorBrush x:Key="KeyBorderBrush" Color="#344E80" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B2A4A" Offset="0" />
        <GradientStop Color="#14203A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#263B66" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#121C33" />
    <SolidColorBrush x:Key="KeyBevelBrush" Color="#0A1124" />
    <SolidColorBrush x:Key="KeyTopHighlightBrush" Color="#26FFFFFF" />
    <LinearGradientBrush x:Key="ModifierBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#881B2C" Offset="0" />
        <GradientStop Color="#681320" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EnterKeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EF233C" Offset="0" />
        <GradientStop Color="#C8142B" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EnterKeyHoverBrush" Color="#F84359" />
    <SolidColorBrush x:Key="EnterKeyTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A3B6D6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#EF233C" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ArmedBackgroundBrush" Color="#3D1422" />
    <SolidColorBrush x:Key="ArmedBorderBrush" Color="#EF233C" />
    <SolidColorBrush x:Key="SuggestionBrush" Color="#0E172C" />
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#2E4775" />
    <SolidColorBrush x:Key="SpaceBarAccentBrush" Color="#EF233C" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#14203B" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#354F80" />

    <Color x:Key="KeyGlowColor">#EF233C</Color>
    <sys:Double x:Key="KeyGlowOpacity">0.40</sys:Double>
    <sys:Double x:Key="KeyGlowBlur">10</sys:Double>
    <Thickness x:Key="KeyBorderThickness">1</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">7</CornerRadius>
    <sys:String x:Key="ThemeBadgeText">SPIDER-MAN</sys:String>
</ResourceDictionary>
