<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Crisp Frost Platinum: machined light chassis, recessed deck, ceramic keycaps -->
    <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ECF0F6" Offset="0" />
        <GradientStop Color="#E1E7F0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C5D0E0" />
    <SolidColorBrush x:Key="KeyDeckBrush" Color="#D7DFEB" />
    <SolidColorBrush x:Key="KeyBorderBrush" Color="#CBD4E3" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F6F8FC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#EBF2FE" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#DCE7F9" />
    <SolidColorBrush x:Key="KeyBevelBrush" Color="#BCC7D8" />
    <SolidColorBrush x:Key="KeyTopHighlightBrush" Color="#CCFFFFFF" />
    <LinearGradientBrush x:Key="ModifierBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6ECF5" Offset="0" />
        <GradientStop Color="#DAE2EE" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="EnterKeyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2563EB" Offset="0" />
        <GradientStop Color="#1D4ED8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="EnterKeyHoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="EnterKeyTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#141820" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#556173" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ArmedBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="ArmedBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SuggestionBrush" Color="#F8FAFD" />
    <SolidColorBrush x:Key="HeaderPillBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="SpaceBarAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#BAC5D6" />

    <Color x:Key="KeyGlowColor">#2563EB</Color>
    <sys:Double x:Key="KeyGlowOpacity">0.0</sys:Double>
    <sys:Double x:Key="KeyGlowBlur">0</sys:Double>
    <Thickness x:Key="KeyBorderThickness">1</Thickness>
    <CornerRadius x:Key="KeyCornerRadius">7</CornerRadius>
</ResourceDictionary>
